+bool DekoCompiler::OutputDkshToMemory(void** outData, uint32_t* outSize)
+{
+	DkshHeader hdr = {};
+	hdr.magic        = DKSH_MAGIC;
+	hdr.header_sz    = sizeof(DkshHeader);
+	hdr.control_sz   = Align256(sizeof(DkshHeader) + sizeof(DkshProgramHeader));
+	hdr.code_sz      = Align256((m_stage != pipeline_stage_compute ? 0x80 : 0x00) + m_codeSize) + Align256(m_dataSize);
+	hdr.programs_off = sizeof(DkshHeader);
+	hdr.num_programs = 1;
+
+	const uint32_t total = hdr.control_sz + hdr.code_sz;
+	uint8_t* out = (uint8_t*)calloc(1, total);
+	if (!out)
+		return false;
+	uint32_t pos = 0;
+	memcpy(out + pos, &hdr, sizeof(hdr)); pos += sizeof(hdr);
+	memcpy(out + pos, &m_dkph, sizeof(m_dkph));
+	pos = hdr.control_sz;
+	if (m_stage != pipeline_stage_compute)
+	{
+		pos += s_shaderStartOffset;
+		memcpy(out + pos, &m_nvsh, sizeof(m_nvsh)); pos += sizeof(m_nvsh);
+	}
+	memcpy(out + pos, m_code, m_codeSize); pos += m_codeSize;
+	pos = Align256(pos);
+	if (m_dataSize)
+		memcpy(out + pos, m_data, m_dataSize);
+	*outData = out;
+	*outSize = total;
+	return true;
+}
